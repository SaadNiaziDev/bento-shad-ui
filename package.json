{
  "name": "bento-shad-ui",
  "version": "0.2.2",
  "description": "Bento-grid UI library with shadcn/ui anatomy: framework-free CSS, a typed vanilla core, React components, pencil-drawn characters, a shadcn/Tailwind v4 theme and a Flutter theme from one token file.",
  "keywords": [
    "ui",
    "design-system",
    "bento",
    "shadcn",
    "tailwind",
    "react",
    "css",
    "components",
    "dark-mode",
    "flutter",
    "illustrations",
    "characters",
    "accessible-components",
    "typescript",
    "nextjs",
    "bento-grid",
    "css-components",
    "design-tokens",
    "llms-txt",
    "ai-ready",
    "component-library",
    "shadcn-ui"
  ],
  "license": "MIT",
  "author": "Saad Ali Khan (https://github.com/SaadNiaziDev)",
  "homepage": "https://saadniazidev.github.io/bento-shad-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaadNiaziDev/bento-shad-ui.git"
  },
  "bugs": {
    "url": "https://github.com/SaadNiaziDev/bento-shad-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/auto.js",
    "./dist/bento.iife.js",
    "./dist/bento.iife.min.js",
    "./dist/illustrations.iife.js",
    "./dist/illustrations.iife.min.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/core/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/types/core/index.d.ts",
      "default": "./dist/auto.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "default": "./dist/react.js"
    },
    "./illustrations": {
      "types": "./dist/types/illustrations/index.d.ts",
      "default": "./dist/illustrations.js"
    },
    "./illustrations/*": "./dist/illustrations/*",
    "./bento.css": "./dist/bento.css",
    "./bento.min.css": "./dist/bento.min.css",
    "./tokens.css": "./dist/tokens.css",
    "./shadcn-theme.css": "./dist/shadcn-theme.css",
    "./tokens.json": "./dist/tokens.json",
    "./flutter/bento_theme.dart": "./dist/flutter/bento_theme.dart",
    "./llms.txt": "./llms.txt",
    "./llms-full.txt": "./llms-full.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "r",
    "docs",
    "llms.txt",
    "llms-full.txt",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "docs": "node scripts/docs.mjs",
    "docs:serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/tokens.test.mjs test/build.test.mjs test/react.test.mjs test/illustrations.test.mjs test/interactions.test.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run docs",
    "prepublishOnly": "npm run check",
    "docs:format": "node scripts/format-docs.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.24.0",
    "linkedom": "^0.18.15",
    "marked": "^15.0.12",
    "prettier": "^3.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^1.29.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
